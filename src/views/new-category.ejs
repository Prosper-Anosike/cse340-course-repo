<%- include('partials/header', { title, currentPath }) %>
<section class="page-intro content-width">
  <p class="eyebrow">CSE 340 Service Network</p>
  <h1>Add a <span>category.</span></h1>
</section>
<form class="organization-form content-width" action="/new-category" method="post">
  <div class="form-field">
    <label for="name">Category name</label>
    <input id="name" name="name" type="text" required maxlength="100" value="<%= flash.oldInput?.[0] ?? '' %>">
  </div>
  <button class="button button-light" type="submit">Create category</button>
</form>
<%- include('partials/footer', { currentYear: new Date().getFullYear() }) %>