<%- include('partials/header', { title, currentPath }) %>
<section class="page-intro content-width">
  <p class="eyebrow">CSE 340 Service Network</p>
  <h1><%= headingStart %> <span><%= headingEmphasis %></span></h1>
  <p>Here are a few of our partner organizations:</p>
</section>
<section class="organization-grid content-width" aria-label="Partner organizations">
  <% organizations.forEach((organization) => { %>
  <article class="organization-card">
    <img src="/images/<%= organization.logoFilename %>" alt="<%= organization.name %> logo" width="100" height="100">
    <div class="card-copy">
      <h2><%= organization.name %></h2>
      <p><%= organization.description %></p>
      <p>Email: <a href="mailto:<%= organization.contactEmail %>"><%= organization.contactEmail %></a></p>
    </div>
  </article>
  <% }); %>
</section>
<%- include('partials/footer', { currentYear: new Date().getFullYear() }) %>
