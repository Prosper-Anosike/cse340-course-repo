<%- include('partials/header', { title, currentPath }) %>
<section class="page-intro content-width">
  <p class="eyebrow">CSE 340 Service Network</p>
  <h1>Create your <span>account.</span></h1>
</section>
<form class="organization-form content-width" action="/register" method="post">
  <div class="form-field">
    <label for="name">Name</label>
    <input id="name" name="name" type="text" required maxlength="100" autocomplete="name">
  </div>
  <div class="form-field">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required maxlength="100" autocomplete="email">
  </div>
  <div class="form-field">
    <label for="password">Password</label>
    <input id="password" name="password" type="password" required autocomplete="new-password">
  </div>
  <button class="button button-light" type="submit">Register</button>
</form>
<%- include('partials/footer', { currentYear: new Date().getFullYear() }) %>
