<%- include('partials/header', { title, currentPath }) %>
<section class="page-intro content-width">
  <p class="eyebrow">CSE 340 Service Network</p>
  <h1>Add a service <span>project.</span></h1>
</section>
<form class="organization-form content-width" action="/new-project" method="post">
  <div class="form-field">
    <label for="title">Project title</label>
    <input id="title" name="title" type="text" required maxlength="150">
  </div>
  <div class="form-field">
    <label for="description">Description</label>
    <textarea id="description" name="description" required maxlength="1000" rows="5"></textarea>
  </div>
  <div class="form-field">
    <label for="location">Location</label>
    <input id="location" name="location" type="text" required maxlength="200">
  </div>
  <div class="form-field">
    <label for="date">Date</label>
    <input id="date" name="date" type="date" required>
  </div>
  <div class="form-field">
    <label for="organizationId">Sponsoring organization</label>
    <select id="organizationId" name="organizationId" required>
      <option value="">Select an organization</option>
      <% organizations.forEach((organization) => { %>
      <option value="<%= organization.organizationId %>"><%= organization.name %></option>
      <% }); %>
    </select>
  </div>
  <button class="button button-light" type="submit">Create service project</button>
</form>
<%- include('partials/footer', { currentYear: new Date().getFullYear() }) %>