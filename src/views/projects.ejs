<%- include('partials/header', { title, currentPath }) %>
<section class="page-intro content-width">
  <p class="eyebrow">CSE 340 Service Network</p>
  <h1><%= heading %></h1>
</section>
<section class="projects-list content-width" aria-label="Featured service projects">
  <% projects.forEach((project, index) => { %>
  <article class="project-row">
    <div class="project-number"><%= String(index + 1).padStart(2, '0') %></div>
    <div class="project-info">
      <h2><a href="/project/<%= project.projectId %>"><%= project.title %></a></h2>
      <p><%= project.description %></p>
      <p class="project-meta"><a href="/organization/<%= project.organizationId %>"><%= project.organizationName %></a> &middot; <%= project.location %> &middot; <%= project.projectDate %></p>
    </div>
  </article>
  <% }); %>
  <% if (projects.length === 0) { %>
  <p>No upcoming service projects are currently scheduled.</p>
  <% } %>
</section>
<%- include('partials/footer', { currentYear: new Date().getFullYear() }) %>
