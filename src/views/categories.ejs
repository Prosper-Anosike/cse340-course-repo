<%- include('partials/header', { title, currentPath }) %>
<section class="page-intro content-width">
  <p class="eyebrow">Start with what moves you</p>
  <h1><%= headingStart %> <span><%= headingEmphasis %></span></h1>
  <p>There are many ways to strengthen a community. Explore a category and find the kind of good you want to do.</p>
</section>
<section class="category-list content-width" aria-label="Service categories">
  <% categories.forEach((category, index) => { %>
  <a class="category-row" href="/projects">
    <span class="category-number"><%= String(index + 1).padStart(2, '0') %></span>
    <h2><%= category.name %></h2>
    <span class="category-action">View all projects <span aria-hidden="true">&rarr;</span></span>
  </a>
  <% }); %>
</section>
<%- include('partials/footer', { currentYear: new Date().getFullYear() }) %>
